{
	// fallow (npm run fallow, CI): unused files, exports, types and dependencies, import cycles,
	// duplicated code and complexity. `fallow audit` fails only on what a change adds (compared
	// with main), so the code inherited from the original game doesn't block anyone; `npm run
	// fallow:report` shows everything, inherited included.
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": ["src/main.ts", "test/**/*.test.ts", "test/**/*.test.tsx", "cli/play.ts", "cli/register.mjs", "cli/page.ts",
		// the new UI's end-to-end test, run with node (npm run e2e)
		"test/e2e/game.ts",
		// the arena's worker processes (test/arena/pool.ts) and its comparison (npm run arena:compare)
		"test/arena/worker.ts", "test/arena/compare-cli.ts",
		// run by hand with node: docs/ui's tokens, card list, gallery and renders
		"scripts/ui-design.mjs",
		// stylelint's two rules of our own, which .stylelintrc.json loads
		"scripts/stylelint-rules.mjs",
		// the UI's components' CSS and its faces, which docs/ui's pages load (the game loads them
		// through src/view/game.css)
		"src/view/library.css", "src/view/fonts.css", "docs/ui/live/gallery.css"],
	// The original bundle, the harness (scripts pasted into the page, with top-level await) and
	// the contract scripts (read as text by test/contracts.ts and record.js)
	"ignorePatterns": ["game/**", "reference/**", "public/**", "harness/**", "test/contracts/**", "docs/ui/components/**"],
	//index.html loads the game's data lists from game/ as classic files
	"ignoreUnresolvedImports": ["/game/resources/campaigns/campaignlist.js", "/game/resources/scenarios/scenariolist.js"],
	"ignoreExportsUsedInFile": true,
	"duplicates": { "minOccurrences": 2 }
}
