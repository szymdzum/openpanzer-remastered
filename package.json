{
	"name": "openpanzer-remastered",
	"version": "1.0.0",
	"description": "Remaster of Panzer Marshal 3.2.14 (HTML5 Panzer General 2)",
	"directories": {
		"doc": "docs"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview --port 8645",
		"check": "tsc -p . && tsc -p test",
		"check:strict": "tsc -p tsconfig.strict.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "TZ=Europe/Warsaw OPENPANZER_GAME_DIR=$PWD/game nice -n 10 stryker run",
		"verify": "harness/replay.sh; r=$?; harness/ui-replay.sh && exit $r",
		"record": "test/contracts/record.sh",
		"lint": "oxlint --type-aware --deny-warnings src test",
		"knip": "knip --no-progress",
		"gate": "npm run -s check && npm run -s check:strict && npm run -s lint && npm run -s knip && npm run -s test:coverage",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@types/node": "^24.19.0",
		"@vitest/coverage-v8": "^5.0.3",
		"jsdom": "^30.1.1",
		"knip": "^6.42.1",
		"lefthook": "^2.2.2",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2004",
		"ts-blank-space": "^0.9.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.3"
	},
	"private": true,
	"license": "GPL-2.0-or-later"
}
