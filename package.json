{
	"name": "openpanzer-remastered",
	"version": "1.0.0",
	"description": "Remaster of Panzer Marshal 3.2.14 (HTML5 Panzer General 2)",
	"directories": {
		"doc": "docs"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview --port 8645",
		"check": "tsc -p . && tsc -p test && tsc -p cli",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "TZ=Europe/Warsaw OPENPANZER_GAME_DIR=$PWD/game nice -n 10 stryker run",
		"verify": "harness/replay.sh",
		"record": "test/contracts/record.sh",
		"e2e": "TZ=Europe/Warsaw node --import ./cli/register.mjs test/e2e/game.ts",
		"play": "TZ=Europe/Warsaw node --import ./cli/register.mjs cli/play.ts",
		"play:live": "OPENPANZER_CLI=1 vite",
		"arena": "ARENA=1 TZ=Europe/Warsaw vitest run test/arena.test.ts -t 'The AI arena'",
		"lint": "oxlint --type-aware --deny-warnings src test cli",
		"stylelint": "stylelint \"src/view/**/*.css\"",
		"gate": "npm run -s check && npm run -s lint && npm run -s stylelint && npm run -s fallow && npm run -s test:coverage",
		"prepare": "lefthook install",
		"fallow": "fallow audit --base origin/main",
		"fallow:report": "fallow"
	},
	"devDependencies": {
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@testing-library/preact": "^3.2.6",
		"@types/node": "^24.19.0",
		"@vitest/coverage-v8": "^5.0.3",
		"fallow": "3.34.1",
		"fast-check": "^4.10.2",
		"jsdom": "^30.1.1",
		"lefthook": "^2.2.2",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2004",
		"playwright-core": "^1.63.0",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"ts-blank-space": "^0.9.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.3"
	},
	"private": true,
	"license": "GPL-2.0-or-later",
	"dependencies": {
		"@preact/signals": "^2.11.3",
		"preact": "^11.0.2"
	}
}
