{
	// The tests (npm run check), with the game's flags: Node and Vitest types, which the game's own config leaves out
	// (Node's setTimeout returns an object, the browser's a number)
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"types": ["node"]
	},
	"include": ["**/*.ts", "../types/**/*.d.ts"]
}
