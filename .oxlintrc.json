// npm run lint: oxlint with the type-aware rules (tsgolint, the same native TypeScript as tsc).
// Every rule is an error. "overrides" lists, per rule, the files that broke it when it was
// turned on: new files get every rule, and a file leaves a list once it is clean (the lists may
// only shrink). The first override keeps the engine modules, the game host (src/host.ts), the screen
// interface (src/screen.ts) and the screen that shows nothing (src/nullscreen.ts) from importing UI
// modules or game.ts (the engine reads the game through src/context.ts, and shows it through the
// screen interface, which the UI implements in src/view/screen.tsx), the second
// and third the new core (src/core/ and its commands) from importing the old engine, the fourth the new UI
// (src/view/) from importing anything but the core, the host and the screen interface. The react and jsx-a11y
// plugins check the JSX of the new UI's components (src/view/*.tsx, Preact).
{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"typescript",
		"unicorn",
		"oxc",
		"import",
		"react",
		"jsx-a11y"
	],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"no-unused-vars": "off",
		"typescript/no-unsafe-declaration-merging": "off",
		"prefer-const": "error",
		"no-var": "error",
		"eqeqeq": "error",
		"no-shadow": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"typescript/await-thenable": "error",
		"typescript/no-for-in-array": "error",
		"typescript/unbound-method": "error",
		"typescript/no-this-alias": "error",
		"unicorn/no-new-array": "error",
		"no-eval": "error",
		"import/no-cycle": "off",
		"typescript/no-misused-spread": "error",
		"typescript/no-useless-default-assignment": "off",
		"react/rules-of-hooks": "error",
		"react/button-has-type": "error"
	},
	"overrides": [
		{
			"files": [
				"src/ai.ts",
				"src/board.ts",
				"src/combatlog.ts",
				"src/commands.ts",
				"src/context.ts",
				"src/equipment.ts",
				"src/gamerules.ts",
				"src/leaders.ts",
				"src/map.ts",
				"src/mirror.ts",
				"src/prototypes.ts",
				"src/core/random.ts",
				"src/scenario.ts",
				"src/selection.ts",
				"src/state.ts",
				"src/undo.ts",
				"src/unit.ts",
				"src/util.ts",
				"src/visibility.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"./app/page",
									"./app/game",
									"./app/storage",
									"./main"
								],
								"allowTypeImports": true,
								"message": "Engine modules don't import UI modules or game.ts: read the game through src/context.ts (CLAUDE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/app/*.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../view",
									"../view/*"
								],
								"allowTypeImports": true,
								"message": "The running game (src/app/) doesn't import the UI (src/view/): the UI imports it (docs/REFACTOR.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/app/host.ts",
				"src/app/nullscreen.ts",
				"src/app/save.ts",
				"src/app/loader.ts",
				"src/app/screen.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"./page",
									"./game",
									"./storage",
									"../main",
									"../view",
									"../view/*"
								],
								"allowTypeImports": true,
								"message": "Engine modules don't import UI modules or game.ts: read the game through src/context.ts (CLAUDE.md); src/app/ doesn't import src/view/"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/core/*.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../*"
								],
								"message": "The core imports nothing outside src/core/, types included (docs/CORE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/core/commands/*.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../../*"
								],
								"message": "The core imports nothing outside src/core/, types included (docs/CORE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/view/*.ts",
				"src/view/*.tsx"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../*",
									"!../core",
									"!../app",
									"!../prototypes"
								],
								"allowTypeImports": true,
								"message": "The new UI (src/view/) imports only the core, the game host, the screen interface, the settings of src/prototypes.ts, its own components and Preact: never the old UI or game.ts (docs/ui/PLAN.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/board.ts",
				"src/campaign.ts",
				"src/app/page.ts",
				"src/equipment.ts",
				"src/app/storage.ts",
				"src/leaders.ts",
				"src/map.ts",
				"src/scenario.ts",
				"src/app/loader.ts",
				"src/selection.ts",
				"src/undo.ts",
				"test/contracts/engine.contract.js",
				"test/invariants.test.ts",
				"test/outcome.test.ts"
			],
			"rules": {
				"eqeqeq": "off"
			}
		},
		{
			"files": [
				"test/setup.ts"
			],
			"rules": {
				"no-eval": "off"
			}
		},
		{
			"files": [
				"src/combatlog.ts",
				"src/equipment.ts",
				"src/leaders.ts"
			],
			"rules": {
				"no-shadow": "off"
			}
		},
		{
			"files": [
				"src/campaign.ts",
				"src/combatlog.ts",
				"src/context.ts",
				"src/app/page.ts",
				"src/equipment.ts",
				"src/gamerules.ts",
				"src/app/storage.ts",
				"src/leaders.ts",
				"src/map.ts",
				"src/core/random.ts",
				"src/app/loader.ts",
				"src/unit.ts"
			],
			"rules": {
				"no-var": "off"
			}
		},
		{
			"files": [
				"src/core/tables.ts",
				"src/prototypes.ts"
			],
			"rules": {
				"prefer-const": "off"
			}
		},
		{
			"files": [
				"src/ai.ts",
				"src/app/page.ts",
				"src/app/storage.ts"
			],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		},
		{
			"files": [
				"test/contracts.ts"
			],
			"rules": {
				"typescript/no-implied-eval": "off"
			}
		},
		{
			"files": [
				"src/map.ts",
				"src/visibility.ts"
			],
			"rules": {
				"unicorn/no-new-array": "off"
			}
		}
	]
}
