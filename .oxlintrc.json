// npm run lint: oxlint with the type-aware rules (tsgolint, the same native TypeScript as tsc).
// Every rule is an error. "overrides" lists, per rule, the files that broke it when it was
// turned on: new files get every rule, and a file leaves a list once it is clean (the lists may
// only shrink). The first override keeps the engine modules from importing UI modules or
// game.ts (the engine reads the game through src/context.ts), the second and third the new
// core (src/core/ and its commands) from importing the old engine.
{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"typescript",
		"unicorn",
		"oxc",
		"import"
	],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"no-unused-vars": "off",
		"typescript/no-unsafe-declaration-merging": "off",
		"prefer-const": "error",
		"no-var": "error",
		"eqeqeq": "error",
		"no-shadow": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"typescript/await-thenable": "error",
		"typescript/no-for-in-array": "error",
		"typescript/unbound-method": "error",
		"typescript/no-this-alias": "error",
		"unicorn/no-new-array": "error",
		"no-eval": "error",
		"import/no-cycle": "off",
		"typescript/no-misused-spread": "error",
		"typescript/no-useless-default-assignment": "off"
	},
	"overrides": [
		{
			"files": [
				"src/actions.ts",
				"src/ai.ts",
				"src/board.ts",
				"src/combatlog.ts",
				"src/commands.ts",
				"src/context.ts",
				"src/equipment.ts",
				"src/gamerules.ts",
				"src/leaders.ts",
				"src/map.ts",
				"src/prototypes.ts",
				"src/rng.ts",
				"src/savegame.ts",
				"src/scenario.ts",
				"src/scenarioloader.ts",
				"src/selection.ts",
				"src/state.ts",
				"src/undo.ts",
				"src/unit.ts",
				"src/util.ts",
				"src/visibility.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"./dom",
									"./game",
									"./gamestate",
									"./ui",
									"./uibuilder",
									"./uicombatlog",
									"./render",
									"./animation",
									"./aiscripted",
									"./osglue",
									"./main",
									"./style",
									"./sound"
								],
								"allowTypeImports": true,
								"message": "Engine modules don't import UI modules or game.ts: read the game through src/context.ts (CLAUDE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/core/*.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../*",
									"!../prototypes",
									"!../rng"
								],
								"allowTypeImports": true,
								"message": "The new core imports only the tables of src/prototypes.ts, src/rng.ts and types: not the old engine (docs/CORE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/core/commands/*.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../../*",
									"!../../prototypes",
									"!../../rng"
								],
								"allowTypeImports": true,
								"message": "The new core imports only the tables of src/prototypes.ts, src/rng.ts and types: not the old engine (docs/CORE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/ai.ts",
				"src/aiscripted.ts",
				"src/board.ts",
				"src/campaign.ts",
				"src/dom.ts",
				"src/equipment.ts",
				"src/game.ts",
				"src/gamerules.ts",
				"src/gamestate.ts",
				"src/leaders.ts",
				"src/map.ts",
				"src/osglue.ts",
				"src/render.ts",
				"src/scenario.ts",
				"src/scenarioloader.ts",
				"src/selection.ts",
				"src/ui.ts",
				"src/uibuilder.ts",
				"src/uicombatlog.ts",
				"src/undo.ts",
				"src/unit.ts",
				"test/contracts/engine.contract.js",
				"test/contracts/unit.contract.js",
				"test/headless.test.ts",
				"test/invariants.test.ts",
				"test/outcome.test.ts"
			],
			"rules": {
				"eqeqeq": "off"
			}
		},
		{
			"files": [
				"test/setup.ts"
			],
			"rules": {
				"no-eval": "off"
			}
		},
		{
			"files": [
				"src/ai.ts",
				"src/animation.ts",
				"src/combatlog.ts",
				"src/equipment.ts",
				"src/game.ts",
				"src/gamerules.ts",
				"src/leaders.ts",
				"src/osglue.ts",
				"src/render.ts",
				"src/ui.ts",
				"src/uibuilder.ts",
				"src/uicombatlog.ts"
			],
			"rules": {
				"no-shadow": "off"
			}
		},
		{
			"files": [
				"src/ai.ts",
				"src/aiscripted.ts",
				"src/animation.ts",
				"src/campaign.ts",
				"src/combatlog.ts",
				"src/context.ts",
				"src/dom.ts",
				"src/equipment.ts",
				"src/game.ts",
				"src/gamerules.ts",
				"src/gamestate.ts",
				"src/leaders.ts",
				"src/map.ts",
				"src/osglue.ts",
				"src/render.ts",
				"src/rng.ts",
				"src/scenarioloader.ts",
				"src/selection.ts",
				"src/sound.ts",
				"src/style.ts",
				"src/ui.ts",
				"src/uibuilder.ts",
				"src/uicombatlog.ts",
				"src/unit.ts"
			],
			"rules": {
				"no-var": "off"
			}
		},
		{
			"files": [
				"src/actions.ts",
				"src/prototypes.ts"
			],
			"rules": {
				"prefer-const": "off"
			}
		},
		{
			"files": [
				"src/ai.ts",
				"src/dom.ts",
				"src/equipment.ts",
				"src/gamestate.ts",
				"src/uibuilder.ts",
				"test/gamestate.test.ts"
			],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		},
		{
			"files": [
				"src/animation.ts",
				"src/ui.ts"
			],
			"rules": {
				"typescript/no-floating-promises": "off"
			}
		},
		{
			"files": [
				"src/actions.ts",
				"src/gamerules.ts"
			],
			"rules": {
				"typescript/no-for-in-array": "off"
			}
		},
		{
			"files": [
				"test/contracts.ts"
			],
			"rules": {
				"typescript/no-implied-eval": "off"
			}
		},
		{
			"files": [
				"test/headless.test.ts"
			],
			"rules": {
				"typescript/no-misused-spread": "off"
			}
		},
		{
			"files": [
				"src/animation.ts",
				"src/game.ts"
			],
			"rules": {
				"typescript/no-this-alias": "off"
			}
		},
		{
			"files": [
				"src/ai.ts",
				"src/dom.ts",
				"test/invariants.test.ts"
			],
			"rules": {
				"typescript/unbound-method": "off"
			}
		},
		{
			"files": [
				"src/map.ts",
				"src/visibility.ts"
			],
			"rules": {
				"unicorn/no-new-array": "off"
			}
		}
	]
}
