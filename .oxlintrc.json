// npm run lint: oxlint with the type-aware rules (tsgolint, the same native TypeScript as tsc).
// Every rule is an error. "overrides" lists, per rule, the files that broke it when it was
// turned on: new files get every rule, and a file leaves a list once it is clean (the lists may
// only shrink). The layers are folders (CLAUDE.md): the first override keeps the old engine
// (src/legacy/) to the core, itself and two files of src/app/ (settings.ts, loader.ts: the exceptions of
// #520), never the UI, the page, game.ts or storage.ts; the next two do the same for the files of the
// running game (src/app/: the host, the screen interface, the screen that shows nothing, the loader and
// the save), and keep every file of src/app/ from importing the UI (src/view/). The two after them keep
// the core (src/core/ and its folders) from importing anything outside itself, and the last of them the
// UI (src/view/) from importing anything but the core and src/app/, and src/legacy/ for types only. The
// react and jsx-a11y plugins check the JSX of the UI's components (src/view/**/*.tsx, Preact).
{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"typescript",
		"unicorn",
		"oxc",
		"import",
		"react",
		"jsx-a11y"
	],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"no-unused-vars": "off",
		"typescript/no-unsafe-declaration-merging": "off",
		"prefer-const": "error",
		"no-var": "error",
		"eqeqeq": "error",
		"no-shadow": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"typescript/await-thenable": "error",
		"typescript/no-for-in-array": "error",
		"typescript/unbound-method": "error",
		"typescript/no-this-alias": "error",
		"unicorn/no-new-array": "error",
		"no-eval": "error",
		"import/no-cycle": "off",
		"typescript/no-misused-spread": "error",
		"typescript/no-useless-default-assignment": "off",
		"react/rules-of-hooks": "error",
		"react/button-has-type": "error"
	},
	"overrides": [
		{
			"files": [
				"src/legacy/**/*.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../view",
									"../view/*",
									"../main",
									"../app/*",
									"!../app/settings",
									"!../app/loader"
								],
								"message": "The old engine (src/legacy/) imports the core and itself, and of src/app/ only settings.ts (map.ts, mirror.ts) and loader.ts (scenario.ts), the exceptions of #520: it reads the game through src/legacy/context.ts and never imports the UI, the page, game.ts or storage.ts (CLAUDE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/app/*.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../view",
									"../view/*"
								],
								"allowTypeImports": true,
								"message": "The running game (src/app/) doesn't import the UI (src/view/): the UI imports it (docs/REFACTOR.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/app/host.ts",
				"src/app/nullscreen.ts",
				"src/app/save.ts",
				"src/app/loader.ts",
				"src/app/screen.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"./page",
									"./game",
									"./storage",
									"../main",
									"../view",
									"../view/*"
								],
								"allowTypeImports": true,
								"message": "Engine modules don't import UI modules or game.ts: read the game through src/legacy/context.ts (CLAUDE.md); src/app/ doesn't import src/view/"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/core/*.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../*",
									"../*/**"
								],
								"message": "The core imports nothing outside src/core/, types included (docs/CORE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/core/commands/*.ts",
				"src/core/remastered/*.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../../*",
									"../../*/**"
								],
								"message": "The core imports nothing outside src/core/, types included (docs/CORE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/view/*.ts",
				"src/view/*.tsx"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../*",
									"!../core",
									"!../app",
									"!../legacy"
								],
								"allowTypeImports": true,
								"message": "The new UI (src/view/) imports only the core, the game host, the screen interface, the settings (src/app/settings.ts), its own components and Preact: never the old UI or game.ts (docs/ui/PLAN.md)"
							},
							{
								"group": [
									"../legacy",
									"../legacy/*",
									"!../legacy/prototypes"
								],
								"allowTypeImports": true,
								"message": "The UI imports src/legacy/ for types only (the command results), never at run time; the one exception is prototypes.ts (its tables and texts), the same as before (CLAUDE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/view/*/*.ts",
				"src/view/*/*.tsx"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"../../*",
									"!../../core",
									"!../../app",
									"!../../legacy"
								],
								"allowTypeImports": true,
								"message": "The new UI (src/view/) imports only the core, the game host, the screen interface, the settings (src/app/settings.ts), its own components and Preact: never the old UI or game.ts (docs/ui/PLAN.md)"
							},
							{
								"group": [
									"../../legacy",
									"../../legacy/*",
									"!../../legacy/prototypes"
								],
								"allowTypeImports": true,
								"message": "The UI imports src/legacy/ for types only (the command results), never at run time; the one exception is prototypes.ts (its tables and texts), the same as before (CLAUDE.md)"
							}
						]
					}
				]
			}
		},
		{
			"files": [
				"src/legacy/board.ts",
				"src/legacy/campaign.ts",
				"src/app/page.ts",
				"src/legacy/equipment.ts",
				"src/app/storage.ts",
				"src/legacy/leaders.ts",
				"src/legacy/map.ts",
				"src/legacy/scenario.ts",
				"src/app/loader.ts",
				"src/legacy/selection.ts",
				"src/legacy/undo.ts",
				"test/contracts/engine.contract.js",
				"test/invariants.test.ts",
				"test/outcome.test.ts"
			],
			"rules": {
				"eqeqeq": "off"
			}
		},
		{
			"files": [
				"test/setup.ts"
			],
			"rules": {
				"no-eval": "off"
			}
		},
		{
			"files": [
				"src/legacy/combatlog.ts",
				"src/legacy/equipment.ts",
				"src/legacy/leaders.ts"
			],
			"rules": {
				"no-shadow": "off"
			}
		},
		{
			"files": [
				"src/legacy/campaign.ts",
				"src/legacy/combatlog.ts",
				"src/legacy/context.ts",
				"src/app/page.ts",
				"src/legacy/equipment.ts",
				"src/legacy/gamerules.ts",
				"src/app/storage.ts",
				"src/legacy/leaders.ts",
				"src/legacy/map.ts",
				"src/core/random.ts",
				"src/app/loader.ts",
				"src/legacy/unit.ts"
			],
			"rules": {
				"no-var": "off"
			}
		},
		{
			"files": [
				"src/app/settings.ts",
				"src/core/tables.ts",
				"src/legacy/prototypes.ts"
			],
			"rules": {
				"prefer-const": "off"
			}
		},
		{
			"files": [
				"src/legacy/ai.ts",
				"src/app/page.ts",
				"src/app/storage.ts"
			],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		},
		{
			"files": [
				"test/contracts.ts"
			],
			"rules": {
				"typescript/no-implied-eval": "off"
			}
		},
		{
			"files": [
				"src/legacy/map.ts",
				"src/legacy/visibility.ts"
			],
			"rules": {
				"unicorn/no-new-array": "off"
			}
		}
	]
}
