{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write",
				"hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edit.sh", "timeout": 60 }]
			}
		],
		"Stop": [
			{
				"hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-stop.sh", "timeout": 120 }]
			}
		]
	}
}
