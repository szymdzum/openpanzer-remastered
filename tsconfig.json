{
	// Type checking only (npm run check). Vite serves and builds src/*.ts with the types blanked
	// out by ts-blank-space (vite.config.ts): same lines and columns as the source.
	"compilerOptions": {
		"target": "es2017",
		"lib": ["es2017", "dom"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": false,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "types/**/*.d.ts"]
}
